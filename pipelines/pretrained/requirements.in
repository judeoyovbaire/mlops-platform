# Direct dependencies for the HuggingFace pretrained pipeline image.
# Human-edited. The installable lockfile (requirements.txt) is GENERATED:
#   uv pip compile --python-version=3.12 --generate-hashes --emit-index-url \
#     --output-file=pipelines/pretrained/requirements.txt pipelines/pretrained/requirements.in
#   (run from the repo root; the linux/amd64 target comes from [tool.uv.pip] in pyproject.toml)
# CI fails if requirements.txt is stale relative to this file.
--extra-index-url https://download.pytorch.org/whl/cpu
# Python 3.12 (JDH-424): this image saves safetensors artifacts, which are
# interpreter-portable, so unlike the training image it is not tied to the
# serving runtime's Python. 3.10 is end of life, and pillow/filelock fixes
# need >= 3.11.
# transformers tracks the minor that KServe's huggingfaceserver serves with
# (v0.21.0: transformers 5.13.0, serving-runtime-contract.yaml), so the
# artifact is written by the version that reads it. 5.x needs
# huggingface_hub >= 1.5, < 2.0 (JDH-412).
transformers==5.13.1
huggingface_hub==1.33.0
mlflow==3.17.2
torch==2.13.0
# MLflow S3 artifact uploads happen CLIENT-side - every image that logs
# artifacts needs boto3 (discovered live: training succeeded, artifact
# upload died).
boto3==1.40.16
