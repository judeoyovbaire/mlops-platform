# Direct dependencies for the training pipeline image.
# Human-edited. The installable lockfile (requirements.txt) is GENERATED:
#   uv pip compile --python-version=3.10 --generate-hashes --emit-index-url \
#     --output-file=pipelines/training/requirements.txt pipelines/training/requirements.in
#   (run from the repo root; the linux/amd64 target comes from [tool.uv.pip] in pyproject.toml)
# CI fails if requirements.txt is stale relative to this file.
# pandas/scikit-learn/cloudpickle track the KServe serving runtime image.
# Source of truth: pipelines/serving-runtime-contract.yaml (drift fails CI).
# The serving pyfunc is cloudpickled at training time and unpickled by
# MLServer - Python and pickle-critical library versions must match or the
# model fails to load ("code expected at most 16 arguments, got 18").
pandas==2.3.3
scikit-learn==1.9.1
cloudpickle==3.1.2
# mlflow-skinny, not mlflow: the image is a tracking client (log, register,
# pyfunc save) and always talks to the MLflow server, so it needs none of the
# server, UI or plotting stack. Full mlflow pulled in matplotlib -> pillow,
# whose open advisories are fixed only in pillow 13 (Python >= 3.11), and this
# image is held on 3.10 by MLServer (JDH-424). Skinny drops matplotlib,
# pillow, pyarrow, SQLAlchemy and Flask: 110 -> 70 locked packages.
# It also drops skops, the default format of mlflow.sklearn.log_model in
# 3.17; train_model.py sets serialization_format="cloudpickle" explicitly.
mlflow-skinny==3.18.0
joblib==1.6.0
pandera==0.35.0
opentelemetry-api==1.45.2
opentelemetry-sdk==1.45.2
opentelemetry-exporter-otlp-proto-grpc==1.45.2
shap==0.54.1
# Resolver floor: without it, backtracking can select numba<=0.53
# (sdist-only, Python <3.10) and break the image build.
numba>=0.61
# MLflow S3 artifact uploads happen CLIENT-side - every image that logs
# artifacts needs boto3 (discovered live: training succeeded, artifact
# upload died).
boto3==1.43.123
